<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical"
    android:background="@color/screen_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Set New Password" android:textColor="@color/text_primary"
        android:textSize="28sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Choose a new password with at least six characters."
        android:textColor="@color/text_secondary" android:layout_marginTop="8dp" />
    <EditText android:id="@+id/inputNewPassword" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:hint="New password" android:inputType="textPassword" android:singleLine="true" />
    <EditText android:id="@+id/inputNewConfirmPassword" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:hint="Confirm new password" android:inputType="textPassword" android:singleLine="true" />
    <Button android:id="@+id/btnSavePassword" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="18dp"
        android:text="Save Password" android:backgroundTint="@color/green_primary"
        android:textColor="@color/white" />
</LinearLayout>