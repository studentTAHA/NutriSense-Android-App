<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical"
    android:background="@color/screen_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Forgot Password" android:textColor="@color/text_primary"
        android:textSize="28sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Enter the email address linked to your NutriSense account. This demo simulates recovery locally."
        android:textColor="@color/text_secondary" android:layout_marginTop="10dp" />
    <EditText android:id="@+id/inputRecoveryEmail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:hint="Email address" android:inputType="textEmailAddress" android:singleLine="true" />
    <Button android:id="@+id/btnRecover" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="18dp"
        android:text="Continue" android:backgroundTint="@color/green_primary"
        android:textColor="@color/white" />
</LinearLayout>